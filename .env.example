# NestJS API base URL
EXPO_PUBLIC_API_URL=http://localhost:8000

# Local UI work only — skip login / role checks (__DEV__ required).
# Set to true to open /dashboard without signing in. Never enable in production.
EXPO_PUBLIC_DEV_BYPASS_AUTH=false

# Optional: email of an existing DB user to load/save personal info & documents while auth bypass is on.
EXPO_PUBLIC_DEV_PROFILE_EMAIL=

# Google Maps (Maps SDK for iOS / Android). Required at EAS build time so the
# react-native-maps config plugin can embed the key and enable Google pods.
# Restrict the key to bundle ID pro.driveinstructor.instructorhub + Maps SDK.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

EXPO_PUBLIC_SUPRSEND_VAPID_PUBLIC_KEY=
EXPO_PUBLIC_SUPRSEND_PUBLIC_KEY=

EXPO_PUBLIC_COGNITO_REGION=
EXPO_PUBLIC_COGNITO_INSTRUCTOR_CLIENT_ID=